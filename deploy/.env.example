# Keystone bootstrap credentials
# Required by keystone compose deployment when bound to 0.0.0.0
TPT_AUTH_BOOTSTRAP_USER=admin
TPT_AUTH_BOOTSTRAP_PASSWORD=changeme
POSTGRES_PASSWORD=postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Capability root signing key (32 raw bytes). Generate with:
#   cargo run -p tpt-soma-api --bin tpt-soma-admin -- gen-key
# then copy dev-keys/signing_key.bin onto the capability-secrets volume
# (compose: docker cp ... tpt-soma-api:/run/secrets/capability_root_key).
CAPABILITY_ROOT_KEY_PATH=/run/secrets/capability_root_key

# Set to 1 in any non-dev deployment: the API/Flight servers refuse to start
# with an ephemeral (throwaway) signing key.
TPT_ENFORCE_SECRETS=0
