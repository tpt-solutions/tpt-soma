# Values for real (non-dev) deployments: supply real secrets here and never
# commit the file. Copy to values-secrets.yaml and fill in.

capability:
  # base64 of the 32-byte Ed25519 signing key:
  #   certutil -encode ...  or  base64 < signing_key.bin
  rootKeyBase64: ""

keystone:
  auth:
    bootstrapUser: admin
    bootstrapPassword: "CHANGE_ME_STRONG_PASSWORD"

minio:
  rootUser: minioadmin
  rootPassword: "CHANGE_ME_STRONG_MINIO_PASSWORD"

api:
  env:
    databaseUrl: "postgres://admin:CHANGE_ME_STRONG_PASSWORD@keystone:5432/tpt_soma"
    minioAccessKey: minioadmin
    minioSecretKey: "CHANGE_ME_STRONG_MINIO_PASSWORD"
    dpEpsilon: "1.0"

flight:
  env:
    databaseUrl: "postgres://admin:CHANGE_ME_STRONG_PASSWORD@keystone:5432/tpt_soma"
