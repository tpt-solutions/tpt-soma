FROM rust:1.97-slim AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --bin tpt-soma-api && \
    cargo build --release --bin tpt-soma-flight
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/tpt-soma-api /usr/local/bin/tpt-soma-api
COPY --from=builder /app/target/release/tpt-soma-flight /usr/local/bin/tpt-soma-flight
EXPOSE 8080
CMD ["tpt-soma-api"]
