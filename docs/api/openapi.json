{
  "openapi": "3.1.0",
  "info": {
    "title": "tpt-soma API",
    "version": "0.1.0",
    "description": "Hand-maintained description of the tpt-soma HTTP API. A test in crates/tpt-soma-api/src/server.rs checks every method and path against the router, so a route cannot be added or removed without updating this file. Request and response schemas are loose (`object`) except where noted; tighten them as the handler types are made public."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Probes"
        ],
        "operationId": "health",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Probes"
        ],
        "operationId": "metrics",
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/ingest/vcf": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "operationId": "ingestVcf",
        "summary": "Upload a VCF file (genomic_raw)",
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "requestBody": {
          "required": true,
          "description": "VCF file, up to 256 MB",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
