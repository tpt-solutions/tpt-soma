    "/api/v1/cohorts/{cohort_id}/budget": {
      "get": {
        "tags": [
          "Differential privacy"
        ],
        "operationId": "getCohortBudget",
        "summary": "Dry run: whether a DP export would fit the cohort's budget. Spends nothing and writes no audit row.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cohort_id": {
                      "type": "string"
                    },
                    "epsilon_cap": {
                      "type": "number"
                    },
                    "remaining_budget": {
                      "type": "number"
                    },
                    "requested_sensitivity": {
                      "type": "number"
                    },
                    "would_succeed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "cohort_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sensitivity",
            "in": "query",
            "required": false,
            "description": "Epsilon the export would spend (positive, finite, default 1.0)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cohorts/{cohort_id}/aggregate/count": {
      "post": {
        "tags": [
          "Differential privacy"
        ],
        "operationId": "cohortAggregateCount",
        "summary": "Release a noisy cohort count. Spends epsilon and records the spend in the audit ledger before returning. Requires export action.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cohort_id": {
                      "type": "string"
                    },
                    "noisy_count": {
                      "type": "number"
                    },
                    "epsilon_spent": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "cohort_id",
            "in": "path",
            "required": true,
            "description": "",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cohort_id"
                ],
                "properties": {
                  "cohort_id": {
                    "type": "string"
                  },
                  "sensitivity": {
                    "type": "number",
                    "description": "Epsilon to spend (positive, finite, default 1.0). Zero, negative, NaN and infinite values are rejected with 400."
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
