  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Capability token issued by tpt-soma-admin issue, sent as the bearer value."
      }
    },
    "schemas": {
      "SampleRecord": {
        "type": "object",
        "required": [
          "sample_id",
          "source"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "dataset_provenance": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "VariantRecord": {
        "type": "object",
        "required": [
          "variant_id",
          "chromosome",
          "position",
          "reference",
          "alternate"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "chromosome": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "reference": {
            "type": "string"
          },
          "alternate": {
            "type": "string"
          },
          "rsid": {
            "type": [
              "string",
              "null"
            ]
          },
          "clinvar_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "genotype": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UmapRecord": {
        "type": "object",
        "required": [
          "sample_id",
          "cell_id",
          "umap1",
          "umap2",
          "cluster"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "format": "uuid"
          },
          "cell_id": {
            "type": "string"
          },
          "umap1": {
            "type": "number"
          },
          "umap2": {
            "type": "number"
          },
          "cluster": {
            "type": "string"
          }
        }
      },
      "VariantExpressionJoin": {
        "type": "object",
        "required": [
          "variant_id",
          "cell_id",
          "gene_id",
          "count"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "chromosome": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "reference": {
            "type": "string"
          },
          "alternate": {
            "type": "string"
          },
          "rsid": {
            "type": [
              "string",
              "null"
            ]
          },
          "cell_id": {
            "type": "string"
          },
          "gene_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error. The body is a plain-text message.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Upload rate limit exceeded (10 uploads per minute per subject). Retry-After gives the wait in seconds.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  }
