    "/api/v1/trials": {
      "post": {
        "tags": [
          "Clinica"
        ],
        "operationId": "createTrial",
        "summary": "Create a clinical trial protocol with eligibility criteria, arms and visits. Requires an unscoped (*) token.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "trial_name",
                  "cohort_label",
                  "criteria",
                  "arms",
                  "visits"
                ],
                "properties": {
                  "trial_name": {
                    "type": "string"
                  },
                  "cohort_label": {
                    "type": "string"
                  },
                  "criteria": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "key",
                        "min",
                        "max"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "inclusion",
                            "exclusion"
                          ]
                        },
                        "key": {
                          "type": "string"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "arms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "allocation_ratio": {
                          "type": "integer",
                          "minimum": 1,
                          "default": 1,
                          "description": "Share of enrollments relative to the other arms. Allocation is not randomization."
                        }
                      }
                    }
                  },
                  "visits": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "day"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "day": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Days after enrollment. Strictly increasing across visits."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
